)continue;
   for(var s=0;s<JM_TOKEN_SECRETS.length;s++){
     try{
       var ts=jmNow(),url="https://"+host+"/"+jmStr(path).replace(/^\/+/,""),headers=jmApiHeaders(ts,JM_TOKEN_SECRETS[s]);
       var o={method:(method||"GET").toUpperCase(),headers:headers,timeout:opt.timeout||14000};
       if(o.method!=="GET"){o.body=typeof data==="string"?data:jmForm(data||{});headers["Content-Type"]="application/x-www-form-urlencoded";}
       var raw=java.ajax(url+","+JSON.stringify(o));
       var val=jmDecodeEnvelope(raw,ts);
       jmPut(ctx,"jm_api_host",host);jmPut(ctx,"jm_last_route","app");
       return val;
     }catch(e){errs.push(host+":"+jmStr(e&&e.message||e));}
   }
 }
 throw new Error("APP/API线路失败："+errs.slice(-4).join(" | "));
}
function jmScrambleId(ctx,pid){
 var ds=jmApiDomains(ctx),host=jmGet(ctx,"jm_api_host",ds[0]||"");
 if(!host)throw new Error("没有可用 API 域名");
 for(var i=0;i<ds.length;i++){
   host=i===0?host:ds[i];try{
     var ts=jmNow(),q="/chapter_view_template?id="+encodeURIComponent(pid)+"&mode=vertical&page=0&app_img_shunt=1&express=off&v="+ts;
     var hd=jmApiHeaders(ts,JM_CONTENT_SECRET,"");
     var raw=java.ajax("https://"+host+q+","+JSON.stringify({headers:hd,timeout:12000}));
     var m=jmStr(raw).match(/var\s+scramble_id\s*=\s*(\d+)/);if(m)return m[1];
   }catch(e){}
 }
 return "220980";
}
function jmUpdateSetting(ctx){
 try{
   var d=jmApiRequest(ctx,"setting","GET");
   var ver=jmStr(d.jm3_version||d.version);if(ver)jmPut(ctx,"jm_app_version",ver);
   var ih=jmNormalizeHost(d.img_host||"");if(ih)jmPut(ctx,"jm_img_host",ih);
   return d;
 }catch(e){return {};}
}
function jmImageHost(ctx){
 var h=jmGet(ctx,"jm_img_host","");if(h)return h;
 var d=jmUpdateSetting(ctx);h=jmNormalizeHost(d.img_host||"");return h||JM_IMG_FALLBACK[0];
}

function jmWebRequest(ctx,path,method,data,opt){
 opt=opt||{};var ds=jmRefreshWebDomains(ctx,false),base=jmWebBase(ctx);
 ds=[base].concat(ds.filter(function(x){return x!==base;}));
 var errs=[];
 for(var i=0;i<ds.length;i++){try{
   var b=ds[i].replace(/\/+$/,""),url=/^https?:\/\//i.test(path)?path:b+"/"+jmStr(path).replace(/^\/+/,"");
   var hd=jmHtmlHeaders(b),o={method:(method||"GET").toUpperCase(),headers:hd,timeout:opt.timeout||14000};
   if(o.method!=="GET"){o.body=typeof data==="string"?data:jmForm(data||{});hd["Content-Type"]="application/x-www-form-urlencoded";}
   var raw=java.ajax(url+","+JSON.stringify(o));
   if(jmStr(raw).length<5)throw new Error("空响应");
   jmPut(ctx,"jm_web_base",b);jmPut(ctx,"jm_last_route","web");return raw;
 }catch(e){errs.push(jmStr(e&&e.message||e));}}
 jmRefreshWebDomains(ctx,true);
 throw new Error("网页线路失败："+errs.slice(-3).join(" | "));
}
function jmGetLoginInfo(ctx){
 try{var s=jmCtxSource(ctx),x=jmJson(s.getLoginInfo(),{});return {username:jmStr(x["账号"]),password:jmStr(x["密码"])};}catch(e){return {username:"",password:""};}
}
function jmWebLogin(ctx,u,p){
 var raw=jmWebRequest(ctx,"login","POST",{username:u,password:p,id_remember:"on",login_remember:"on",submit_login:""});
 if(/login-form|name=["']username/i.test(raw)&&!/logout|會員中心|favorite/i.test(raw))throw new Error("网页端登录未确认成功");
 jmPut(ctx,"jm_web_user",u);return true;
}
function jmApiLogin(ctx,u,p){
 var d=jmApiRequest(ctx,"login","POST",{username:u,password:p});
 if(!d||(!d.uid&&!d.username&&!d.s))throw new Error("APP/API登录返回异常");
 jmPut(ctx,"jm_profile",JSON.stringify(d));jmPut(ctx,"jm_api_user",u);
 try{if(d.s&&typeof cookie!=="undefined"&&cookie.setCookie){cookie.setCookie("https://"+jmGet(ctx,"jm_api_host",""),"AVS="+d.s);}}catch(e){}
 return d;
}
function jmLoginBoth(ctx){
 var a=jmGetLoginInfo(ctx);if(!a.username||!a.password)throw new Error("请先填写账号和密码");
 var okA=false,okW=false,err=[];
 try{jmApiLogin(ctx,a.username,a.password);okA=true;}catch(e){err.push("APP: "+jmStr(e&&e.message||e));}
 try{jmWebLogin(ctx,a.username,a.password);okW=true;}catch(e){err.push("Web: "+jmStr(e&&e.message||e));}
 if(!okA&&!okW)throw new Error(err.join("\n"));
 return {app:okA,web:okW,errors:err};
}
function jmEnsureWebLogin(ctx){
 var a=jmGetLoginInfo(ctx);if(!a.username||!a.password)return false;
 try{jmWebLogin(ctx,a.username,a.password);return true;}catch(e){return false;}
}

function jmCover(ctx,x,id){
 var u=jmStr((x||{}).image||(x||{}).pic_s||(x||{}).cover||(x||{}).thumb);
 if(/^https?:\/\//i.test(u))return u;
 if(u){if(u.indexOf("/media/")>=0)return "https://"+jmImageHost(ctx)+"/"+u.replace(/^\/+/,"");return "https://"+jmImageHost(ctx)+"/media/albums/"+u.replace(/^\/+/,"");}
 return id?"https://"+jmImageHost(ctx)+"/media/albums/"+id+"_3x4.jpg":"";
}
function jmAlbumId(u){var m=jmStr(u).match(/\/album\/(\d+)/i);if(m)return m[1];m=jmStr(u).match(/[?&](?:id|aid|jm_album)=(\d+)/i);return m?m[1]:"";}
function jmPhotoId(u){var m=jmStr(u).match(/\/photo\/(\d+)/i);if(m)return m[1];m=jmStr(u).match(/[?&](?:pid|photo)=(\d+)/i);return m?m[1]:"";}

function jmWebSearch(ctx,key,page,order,category){
 var base=jmWebBase(ctx),path;
 if(category&&category!=="all")path="albums/"+category+"?o="+encodeURIComponent(order||"mr")+"&page="+page;
 else path="search/photos?search_query="+encodeURIComponent(key||"")+"&search-type=photos&main_tag=0&o="+encodeURIComponent(order||"mr")+"&page="+page;
 var raw=jmWebRequest(ctx,path,"GET"),doc=Packages.org.jsoup.Jsoup.parse(raw,base),links=doc.select("a[href*=/album/]"),out=[],seen={};
 for(var i=0;i<links.size();i++){
   var a=links.get(i),href=a.absUrl("href")||jmAbs(base,a.attr("href")),id=jmAlbumId(href);if(!id||seen[id])continue;
   var root=a;for(var z=0;z<4&&root.parent()!=null;z++){if(root.select("img").size()>0&&root.text().length>3)break;root=root.parent();}
   var img=root.select("img").first(),title="";
   try{title=root.select(".video-title,.title-truncate,.image-item-text").first().text();}catch(e){}
   if(!title)title=jmStr(a.attr("title")||a.text()||(img?img.attr("alt"):"")).trim();
   if(!title||title.length<1)continue;
   var cover=img?jmStr(img.attr("data-original")||img.attr("data-src")||img.attr("src")):"";cover=jmAbs(base,cover);
   var x={id:id,name:title,author:"",image:cover,tags:[],description:root.text().replace(title,"").trim()};out.push(x);seen[id]=1;
 }
 return out;
}
function jmAppList(ctx,path){
 var d=jmApiRequest(ctx,path,"GET"),arr=Array.isArray(d)?d:(d.content||d.list||d.data||d.items||[]);
 if(!Array.isArray(arr))arr=[];return arr;
}
function jmSearchData(ctx,key,page,order,category){
 var mode=jmRouteMode(ctx),last=jmGet(ctx,"jm_last_route","app"),seq=mode==="auto"?(last==="web"?["web","app"]:["app","web"]):[mode],err=[];
 for(var i=0;i<seq.length;i++){try{
   if(seq[i]==="app"){
     if(category&&category!=="all")return jmAppList(ctx,"categories/filter?page="+page+"&order=&c="+encodeURIComponent(category)+"&o="+encodeURIComponent(order||"mr"));
     return jmAppList(ctx,"search?main_tag=0&search_query="+encodeURIComponent(key||"")+"&page="+page+"&o="+encodeURIComponent(order||"mr")+"&t=a");
   }else return jmWebSearch(ctx,key,page,order,category);
 }catch(e){err.push(jmStr(e&&e.message||e));}}
 throw new Error(err.join(" | "));
}
function jmItem(ctx,x){
 x=x||{};var id=jmStr(x.id||x.aid||x.album_id),m=new Packages.java.util.HashMap(),tags=x.tags||[];
 if(typeof tags==="string")tags=tags.split(/[,\s]+/);
 m.put("name",jmStr(x.name||x.title||("JM"+id)));
 m.put("author",Array.isArray(x.author)?x.author.join(" / "):jmStr(x.author||x.creator||""));
 m.put("coverUrl",jmCover(ctx,x,id));
 m.put("intro",jmStr(x.description||x.intro||x.update_at||""));
 m.put("kind",(Array.isArray(tags)?tags.slice(0,6).join(" · "):jmStr(tags)));
 m.put("bookUrl",jmWebBase(ctx)+"/album/"+id+"?jm_route="+encodeURIComponent(jmGet(ctx,"jm_last_route",jmRouteMode(ctx))));
 return m;
}
function jmListToJava(ctx,list){var out=new Packages.java.util.ArrayList();list=list||[];for(var i=0;i<list.length;i++){var id=jmStr(list[i]&& (list[i].id||list[i].aid||list[i].album_id));if(id)out.add(jmItem(ctx,list[i]));}return out;}

function jmAlbumApp(ctx,id){var d=jmApiRequest(ctx,"album