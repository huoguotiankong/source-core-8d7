adient(135deg,#ed5e78,#f39aaa);color:white}.n{font-size:22px;font-weight:850}.tag{display:inline-block;margin:7px 5px 0 0;padding:3px 7px;background:rgba(255,255,255,.2);border-radius:8px;font-size:11px}.card{margin-top:12px;background:var(--c);border-radius:16px;padding:14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.cell{background:var(--b);padding:10px;border-radius:10px}.k{font-size:10px;color:var(--s)}.v{margin-top:4px;font-size:13px;word-break:break-all}@media(prefers-color-scheme:dark){:root{--b:#111214;--c:#1b1d20;--t:#eee;--s:#9da3ad}}</style></head><body><section class="hero"><div class="n">'+jmEsc(p.username||jmGetLoginInfo(ctx).username||"游客")+'</div><span class="tag">LV'+jmEsc(p.level||"0")+'</span><span class="tag">'+jmEsc(p.level_name||"账号")+'</span><span class="tag">硬币 '+jmEsc(p.coin||"0")+'</span></section><section class="card"><div class="grid"><div class="cell"><div class="k">UID</div><div class="v">'+jmEsc(p.uid||"—")+'</div></div><div class="cell"><div class="k">收藏数</div><div class="v">'+jmEsc(p.album_favorites||"—")+'</div></div><div class="cell"><div class="k">线路模式</div><div class="v">'+jmEsc(route)+'</div></div><div class="cell"><div class="k">API节点</div><div class="v">'+jmEsc(api||"自动")+'</div></div><div class="cell" style="grid-column:1/3"><div class="k">网页域名</div><div class="v">'+jmEsc(web)+'</div></div><div class="cell" style="grid-column:1/3"><div class="k">邮箱</div><div class="v">'+jmEsc(p.email||"—")+'</div></div></div></section></body></html>';
}
function jmOpenAccount(ctx){try{java.startBrowser(jmWebBase(ctx)+"/user","禁漫天堂 · 账户中心",jmAccountHtml(ctx));return true;}catch(e){java.longToast("账户中心失败："+e);return false;}}
function jmOpenExplore(ctx,type,title){try{java.open("explore",jmWebBase(ctx)+"/?legado=jm_explore&type="+encodeURIComponent(type)+"&page={{page}}",title);return true;}catch(e){java.longToast(String(e));return false;}}

function jmBookInfoAlbumId(ctx){
 var id="";
 try{if(book&&book.getVariable)id=jmStr(book.getVariable("jm_id"));}catch(e){}
 if(!id){try{id=jmAlbumId(jmStr(book&&book.bookUrl||""));}catch(e2){}}
 if(!id){try{id=jmAlbumId(jmStr(baseUrl||""));}catch(e3){}}
 return id;
}
function jmBookInfoOpenComments(){var id=jmBookInfoAlbumId(this);return jmOpenComments(this,id);}
function jmBookInfoFavourite(){var id=jmBookInfoAlbumId(this);if(!id){java.toast("无法识别漫画 ID");return true;}try{jmToggleFavorite(this,id);java.toast("收藏操作已提交");}catch(e){java.longToast("收藏失败："+jmStr(e&&e.message||e));}return true;}
function jmBookInfoAccount(){return jmOpenAccount(this);}

