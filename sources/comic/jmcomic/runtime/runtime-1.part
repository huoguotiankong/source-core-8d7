 out=jmUniq(out);
 var good=[];
 for(var k=0;k<out.length&&good.length<6;k++){if(jmProbeWeb(out[k]))good.push(out[k]);}
 if(!good.length)good=out.length?out:[JM_PUB,"https://18comic.vip","https://18comic.ink"];
 var base=good[0];
 jmPut(ctx,"jm_web_base",base);jmPut(ctx,"jm_web_domains",JSON.stringify(good));jmPut(ctx,"jm_web_at",Date.now());
 return good;
}
function jmWebBase(ctx){var b=jmGet(ctx,"jm_web_base","");if(b)return b;return jmRefreshWebDomains(ctx,false)[0]||JM_PUB;}

