" content="light dark"><style>');
 h.push(':root{--bg:#f4f5f7;--card:#fff;--txt:#222;--sub:#8b9098;--line:#e9ebef;--accent:#ef5b78;--soft:#fff0f3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;padding-bottom:84px}.top{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);padding:12px 14px;border-bottom:1px solid var(--line)}.hero{display:flex;gap:10px;align-items:center}.cover{width:42px;height:56px;border-radius:8px;object-fit:cover;background:var(--soft)}.ttl{font-size:17px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sub{font-size:11px;color:var(--sub);margin-top:4px}.btn{border:0;border-radius:18px;padding:8px 12px;background:var(--soft);color:var(--accent);font-weight:700}.list{padding:10px}.card{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:13px;margin-bottom:10px}.head{display:flex;gap:9px;align-items:center}.av{width:38px;height:38px;border-radius:50%;object-fit:cover;background:var(--soft)}.name{font-weight:750;font-size:14px}.time{font-size:10px;color:var(--sub);margin-top:3px}.ct{font-size:15px;line-height:1.7;margin:10px 0;white-space:pre-wrap;word-break:break-word}.reply{margin-left:34px;padding:8px 10px;border-left:2px solid var(--line);background:var(--bg);border-radius:0 9px 9px 0;margin-top:6px;font-size:13px}.act{display:flex;gap:8px}.act button{border:0;background:transparent;color:var(--sub);padding:5px}.pager{text-align:center;padding:10px}.composer{position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.97);border-top:1px solid var(--line);padding:8px 10px max(10px,env(safe-area-inset-bottom))}.replying{font-size:10px;color:var(--accent);display:none;padding:0 4px 5px}.row{display:flex;gap:8px}.input{flex:1;height:40px;border:1px solid var(--line);border-radius:18px;padding:9px 12px;background:var(--bg);color:var(--txt)}.send{width:58px;border:0;border-radius:18px;background:var(--accent);color:#fff;font-weight:800}.empty,.loading,.error{text-align:center;padding:38px 12px;color:var(--sub)}@media(prefers-color-scheme:dark){:root{--bg:#111214;--card:#1b1d20;--txt:#eceff3;--sub:#9da3ad;--line:#2b2e34;--soft:#342127}.top,.composer{background:rgba(27,29,32,.96)}}</style></head><body>');
 h.push('<header class="top"><div class="hero">'+(cover?'<img class="cover" src="'+jmEsc(cover)+'">':'<div class="cover"></div>')+'<div style="min-width:0;flex:1"><div class="ttl">'+jmEsc(title||"禁漫评论")+'</div><div id="sum" class="sub">评论加载中…</div></div><button id="refresh" class="btn">刷新</button></div></header><main id="list" class="list"><div class="loading">正在读取评论…</div></main><div class="pager"><button id="prev" class="btn">上一页</button> <span id="pg">1</span> <button id="next" class="btn">下一页</button></div>');
 h.push('<div class="composer"><div id="replying" class="replying"></div><div class="row"><input id="input" class="input" maxlength="500" placeholder="说点什么…"><button id="send" class="send">发送</button></div></div>');
 h.push('<script>var C='+cfg+',S={page:1,parent:"",parentName:""};function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;","\\\"":"&quot;"}[c]})}function parse(x){try{return JSON.parse(String(x||"{}"))}catch(e){return{ok:false,error:String(e)}}}function call(o){var f=window.jmRun||window.run;if(typeof f!=="function"&&typeof run==="function")f=run;if(typeof f!=="function")return Promise.reject(new Error("阅读端没有注入 run 桥"));return f("jmCommunityBridge.call(this,"+JSON.stringify(o)+")").then(parse)}');
 h.push('function reps(a){if(!a||!a.length)return"";return a.map(function(r){return"<div class=\\"reply\\"><b>"+esc(r.name||"用户")+"</b>："+esc(r.content||"")+"</div>"+reps(r.replies)}).join("")}function card(c){return"<article class=\\"card\\"><div class=\\"head\\">"+(c.avatar?"<img class=\\"av\\" src=\\""+esc(c.avatar)+"\\">":"<div class=\\"av\\"></div>")+"<div><div class=\\"name\\">"+esc(c.name||"JM用户")+"</div><div class=\\"time\\">"+esc(c.time||"")+"</div></div></div><div class=\\"ct\\">"+esc(c.content||"")+"</div><div class=\\"act\\"><button class=\\"rp\\" data-id=\\""+esc(c.id)+"\\" data-name=\\""+esc(c.name||"用户")+"\\">回复</button><span style=\\"color:var(--sub);font-size:11px;padding:5px\\">♥ "+(c.likes||0)+"</span></div>"+reps(c.replies)+"</article>"}');
 h.push('function bind(){Array.prototype.slice.call(document.querySelectorAll(".rp")).forEach(function(b){b.onclick=function(){S.parent=b.dataset.id;S.parentName=b.dataset.name;var r=document.getElementById("replying");r.style.display="block";r.textContent="回复 @"+S.parentName+" · 点此取消";document.getElementById("input").focus()}})}function load(){document.getElementById("list").innerHTML="<div class=\\"loading\\">正在加载…</div>";call({action:"list",id:C.id,page:S.page}).then(function(r){if(!r.ok)throw new Error(r.error||"读取失败");var d=r.data||{},a=d.list||[];document.getElementById("list").innerHTML=a.length?a.map(card).join(""):"<div class=\\"empty\\">还没有评论</div>";document.getElementById("sum").textContent=(d.total||a.length)+" 条评论";document.getElementById("pg").textContent=S.page;bind()}).catch(function(e){document.getElementById("list").innerHTML="<div class=\\"error\\">"+esc(e.message||e)+"</div>"})}');
 h.push('document.getElementById("replying").onclick=function(){S.parent="";S.parentName="";this.style.display="none"};document.getElementById("refresh").onclick=load;document.getElementById("prev").onclick=function(){if(S.page>1){S.page--;load()}};document.getElementById("next").onclick=function(){S.page++;load()};document.getElementById("send").onclick=function(){var b=this,t=document.getElementById("input"),v=t.value.trim();if(!v)return;b.disabled=true;call({action:"post",id:C.id,text:v,parent:S.parent}).then(function(r){if(!r.ok)throw new Error(r.error||"发送失败");t.value="";S.parent="";document.getElementById("replying").style.display="none";S.page=1;load()}).catch(function(e){alert(e.message||e)}).finally(function(){b.disabled=false})};load();</script></body></html>');
 return h.join("");
}
var jmCommunityBridge={
 call:function(ctx,p){
   p=p||{};try{
     if(p.action==="list")return JSON.stringify({ok:true,data:jmComments(ctx,p.id,jmNum(p.page,1))});
     if(p.action==="post"){jmPostComment(ctx,p.id,jmStr(p.text),jmStr(p.parent));return JSON.stringify({ok:true});}
     if(p.action==="favorite"){return JSON.stringify({ok:true,data:jmToggleFavorite(ctx,p.id)});}
     return JSON.stringify({ok:false,error:"未知操作"});
   }catch(e){return JSON.stringify({ok:false,error:jmStr(e&&e.message||e)});}
 }
};
function jmOpenComments(ctx,forced){
 ctx=ctx||this;var id=forced||jmAlbumId(jmStr(baseUrl||""));try{if(!id&&book)id=jmAlbumId(jmStr(book.bookUrl||""));}catch(e){}
 if(!id){java.toast("无法识别漫画 ID");return false;}
 var title="禁漫评论",cover="",total=0;try{title=jmStr(book&&book.name||title);cover=jmStr(book&&book.coverUrl||"");}catch(e){}
 try{var a=jmAlbum(ctx,id);title=jmStr(a.name||title);cover=jmCover(ctx,a,id);total=jmNum(a.comment_total||a.commentCount,0);}catch(e){}
 var html=jmCommentHtml(id,title,cover,total).replace("<script>","<script>try{if(!window.jmRun&&typeof run==='function')window.jmRun=run;}catch(_jmBridge){}");
 java.startBrowser(jmWebBase(ctx)+"/album/"+id+"#comments","💬 "+title+" · 评论",html);return true;
}
function jmAccountHtml(ctx){
 var p=jmJson(jmGet(ctx,"jm_profile","{}"),{}),route=jmRouteName(jmRouteMode(ctx)),web=jmWebBase(ctx),api=jmGet(ctx,"jm_api_host","");
 return '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><style>:root{--b:#f5f6f8;--c:#fff;--t:#222;--s:#8b9098;--a:#ef5b78}body{margin:0;padding:14px;background:var(--b);color:var(--t);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.hero{padding:20px;border-radius:20px;background:linear-gr